rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'categories', 'canTeach',
          'wantsToLearn', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'displayName', 'categories', 'canTeach',
          'wantsToLearn', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.categories is list
        && data.categories.size() <= 10
        && data.canTeach is list
        && data.canTeach.size() <= 20
        && data.wantsToLearn is list
        && data.wantsToLearn.size() <= 20;
    }

    match /users/{uid} {
      // Initially private: users cannot browse strangers' profiles.
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'categories', 'canTeach', 'wantsToLearn', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // No real stranger-matching, messaging, or reputation writes yet.
    // Add participant access, blocks, age-cohort controls, and moderation
    // before exposing live chat or public profile discovery.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
